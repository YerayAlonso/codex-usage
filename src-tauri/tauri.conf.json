{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Usage",
  "version": "0.2.3",
  "identifier": "dev.codex.usage",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "capabilities": ["panel"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Codex quota monitor",
    "publisher": "YerayAlonso",
    "homepage": "https://github.com/YerayAlonso/codex-usage",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "copyright": "Copyright (c) 2026 YerayAlonso",
    "category": "Utility",
    "windows": {
      "nsis": { "displayLanguageSelector": false },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
